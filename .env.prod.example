ENVIRONMENT=production
LOG_LEVEL=INFO
# Ті самі значення, що в ~/crypto-infra/.env на сервері
POSTGRES_USER=crypto
POSTGRES_PASSWORD=change_me
POSTGRES_DB=crypto_p2p
REDIS_PASSWORD=change_me
CORS_ORIGINS=["http://localhost:5173"]
JWT_SECRET=change_me
EXCHANGES=binance,bybit,okx
RATE_LIMIT_INITIAL_RPS=1
# Binance ріже приблизно від 1000-1300 запитів за 5 хвилин: 3 rps тримає нижче межі
RATE_LIMIT_MAX_RPS=3
RATE_LIMIT_COOLDOWN_SEC=300
COLLECTOR_CONCURRENCY=4
COLLECTOR_PRIORITY_PAIRS=USDT/UAH
COLLECTOR_MIN_REFRESH_SEC=5
DATA_STALE_AFTER_SEC=60
