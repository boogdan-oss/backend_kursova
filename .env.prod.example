ENVIRONMENT=production
LOG_LEVEL=INFO
# Ті самі значення, що в ~/crypto-infra/.env на сервері
POSTGRES_USER=crypto
POSTGRES_PASSWORD=change_me
POSTGRES_DB=crypto_p2p
REDIS_PASSWORD=change_me
CORS_ORIGINS=["https://kursovafrontend.vercel.app","http://localhost:5173"]
# Довгий випадковий рядок: openssl rand -hex 32. Без нього вхід у проді не працює
JWT_SECRET=change_me
JWT_ACCESS_TTL_MIN=30
JWT_REFRESH_TTL_DAYS=30
# Посилання в сповіщеннях ведуть сюди
FRONTEND_URL=https://kursovafrontend.vercel.app
EXCHANGES=binance,bybit,okx,bitget,mexc,htx
RATE_LIMIT_INITIAL_RPS=1
# Binance ріже приблизно від 1000-1300 запитів за 5 хвилин: 3 rps тримає нижче межі
RATE_LIMIT_MAX_RPS=3
RATE_LIMIT_COOLDOWN_SEC=300
COLLECTOR_CONCURRENCY=4
COLLECTOR_PRIORITY_PAIRS=USDT/UAH
COLLECTOR_MIN_REFRESH_SEC=5
DATA_STALE_AFTER_SEC=60
# Місце під сирі оголошення на біржу. Корінь диска сервера — 30 ГБ (df -h /; 47 ГБ у консолі
# Oracle — весь завантажувальний диск разом зі службовим /var/oled): 6 бірж × 2 ГБ = 12 ГБ
COLLECTOR_STORAGE_GB_PER_EXCHANGE=2
# Менше вільного місця на диску — collector чистить старі дні й ставить збір на паузу
COLLECTOR_MIN_FREE_DISK_GB=3
# Бот сповіщень (@BotFather). Повідомлення боту читає лише collector
TELEGRAM_BOT_TOKEN=
# Пошта для сповіщень; без SMTP_HOST і SMTP_FROM канал email вимкнений. Порт 465 — SSL, інші — STARTTLS
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# AI-асистент: gemini або claude; auto — Gemini, якщо є GEMINI_API_KEY, інакше Claude.
# Без жодного ключа /ai/chat — 503
ASSISTANT_PROVIDER=auto
# Ключ Gemini: https://aistudio.google.com/apikey. Резервна модель — коли основна перевантажена
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
# AI-асистент на Claude: ключ з https://platform.claude.com (API Keys). Без нього /ai/chat — 503
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max: глибина міркувань і витрата токенів
ASSISTANT_EFFORT=medium
ASSISTANT_MESSAGES_PER_HOUR=30
# Вхід через Google: Google Cloud Console → APIs & Services → Credentials → OAuth client ID
# (Web application). Authorized redirect URI: https://upars.duckdns.org/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Публічна адреса API: з неї будується redirect URI для Google
PUBLIC_API_URL=https://upars.duckdns.org
